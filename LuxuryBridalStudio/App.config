<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="LuxuryBridalStudio" providerName="System.Data.SqlClient"
             connectionString="Data Source=.;Initial Catalog=LuxuryBridalStudio;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
